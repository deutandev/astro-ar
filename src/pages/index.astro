---
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
        />
        <meta name="theme-color" content="#050814" />
        <meta
            name="description"
            content="Explore a solar system in augmented reality with Astro AR."
        />
        <title>Astro AR — Solar System</title>
        <link rel="icon" type="image/png" href="/markers/pattern-bitmap.png" />
        <link rel="stylesheet" href="/styles.css" />
        <script is:inline src="/ar/lib/aframe.min.js"></script>
        <script is:inline src="/ar/lib/aframe-ar.js"></script>
    </head>
    <body>
        <div class="hud" aria-label="Astro AR controls">
            <div class="brand">
                <span class="brand-mark">✦</span>
                <span>
                    ASTRO <b>AR</b>
                </span>
            </div>
            <button
                class="icon-button"
                id="info-button"
                aria-label="Open information"
                aria-haspopup="dialog"
            >
                i
            </button>
            <div class="zoom" aria-label="Zoom controls">
                <button id="zoom-out" aria-label="Zoom out">
                    −
                </button>
                <span id="zoom-value">1×</span>
                <button id="zoom-in" aria-label="Zoom in">
                    +
                </button>
            </div>
        </div>

        <a-scene
            embedded
            vr-mode-ui="enabled: false"
            renderer="antialias: true; colorManagement: true; logarithmicDepthBuffer: true;"
            arjs="sourceType: webcam; trackingMethod: best; debugUIEnabled: false;"
            loading-screen="enabled: false"
        >
            <a-assets timeout="30000">
                <a-asset-item
                    id="solar-system"
                    src="/assets/models/scene.gltf"
                ></a-asset-item>
            </a-assets>
            <a-marker
                id="marker"
                type="pattern"
                url="/markers/pattern-bitmap.patt"
                emitevents="true"
            >
                <a-entity
                    id="solar-model"
                    gltf-model="#solar-system"
                    position="0 0 -1.5"
                    rotation="0 0 0"
                    scale="0.04 0.04 0.04"
                ></a-entity>
            </a-marker>
            <a-entity camera></a-entity>
        </a-scene>
        <div
            class="model-loader"
            id="model-loader"
            role="status"
            aria-live="polite"
        >
            <span class="loader-orbit"></span>
            <span id="model-loader-text">Sedang memuat…</span>
        </div>

        <div
            class="modal-backdrop"
            id="info-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modal-title"
            hidden
        >
            <section class="modal">
                <button
                    class="close"
                    id="close-modal"
                    aria-label="Close information"
                >
                    ×
                </button>
                <div
                    class="language-toggle"
                    role="group"
                    aria-label="Pilihan bahasa"
                >
                    <button id="lang-id" type="button" aria-pressed="true">
                        ID
                    </button>
                    <button id="lang-en" type="button" aria-pressed="false">
                        EN
                    </button>
                </div>
                <p class="eyebrow" id="modal-eyebrow">
                    INFORMASI
                </p>
                <h1 id="modal-title">Tata Surya dalam genggaman.</h1>
                <p id="modal-description">
                    Arahkan kamera ke marker bitmap untuk menjelajahi model tata
                    surya melalui kamera. Bergerak lebih dekat, menjauh, dan
                    gunakan kontrol zoom untuk menemukan orbit favoritmu.
                </p>
                <section class="how-to" aria-labelledby="how-to-label">
                    <strong id="how-to-label">CARA MENGGUNAKAN</strong>
                    <ol class="how-to-steps">
                        <li id="how-step-one">
                            Buka{" "}
                            <a
                                href="https://ar.deutan.dev/"
                                target="_blank"
                                rel="noopener"
                            >
                                ar.deutan.dev
                            </a>{" "}
                            (udah di sini, sih)
                        </li>
                        <li id="how-step-two">
                            Pindai marker berikut dengan kamera
                        </li>
                    </ol>
                    <a
                        id="marker-preview"
                        class="marker-preview"
                        href="/markers/pattern-bitmap.png"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/markers/pattern-bitmap.png"
                            alt="Marker bitmap Astro AR"
                        />
                    </a>
                    <a
                        id="marker-download"
                        class="marker-download"
                        href="/markers/pattern-bitmap.png"
                        download
                    >
                        Unduh gambar marker ↗
                    </a>
                    <p id="how-step-three">
                        Jaga marker tetap terlihat, lalu gerakkan ponsel untuk
                        menjelajahi model.
                    </p>
                </section>
                <hr />
                <footer class="modal-footer">
                    <p class="credit">
                        <strong id="model-label">Model 3D: </strong>
                        <a
                            href="https://skfb.ly/oKOqS"
                            target="_blank"
                            rel="noopener"
                        >
                            “Solar System animation”
                        </a>
                        <br />
                        oleh Samer_Arab_S5
                        <br />
                        <span id="license-prefix">Di bawah lisensi </span>
                        <a
                            href="https://creativecommons.org/licenses/by/4.0/"
                            target="_blank"
                            rel="noopener"
                        >
                            CC BY 4.0
                        </a>
                        .
                    </p>
                    <p>
                        <span id="made-by-label">Dibuat dengan 💙 oleh </span>
                        <a
                            href="https://deutan.dev"
                            target="_blank"
                            rel="noopener"
                        >
                            deutan.dev
                        </a>{" "}
                        |{" "}
                        <a
                            id="github-link"
                            href="https://github.com/deutandev/astro-ar"
                            target="_blank"
                            rel="noopener"
                        >
                            GitHub ↗
                        </a>
                    </p>
                </footer>
            </section>
        </div>
        <script is:inline src="/app.js"></script>
    </body>
</html>
