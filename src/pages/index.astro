---
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
        />
        <meta name="theme-color" content="#050814" />
        <meta
            name="description"
            content="Explore a solar system in augmented reality with Astro AR."
        />
        <title>Astro AR — Solar System</title>
        <link rel="stylesheet" href="/styles.css" />
        <script
            is:inline
            src="https://aframe.io/releases/1.6.0/aframe.min.js"
        ></script>
        <script
            is:inline
            src="https://raw.githack.com/AR-js-org/AR.js/3.4.7/aframe/build/aframe-ar.js"
        ></script>
    </head>
    <body>
        <div class="hud" aria-label="Astro AR controls">
            <div class="brand">
                <span class="brand-mark">✦</span>
                <span>
                    ASTRO <b>AR</b>
                </span>
            </div>
            <button
                class="icon-button"
                id="info-button"
                aria-label="Open information"
                aria-haspopup="dialog"
            >
                i
            </button>
            <div class="zoom" aria-label="Zoom controls">
                <button id="zoom-out" aria-label="Zoom out">
                    −
                </button>
                <span id="zoom-value">1×</span>
                <button id="zoom-in" aria-label="Zoom in">
                    +
                </button>
            </div>
        </div>

        <a-scene
            embedded
            vr-mode-ui="enabled: false"
            renderer="antialias: true; colorManagement: true; logarithmicDepthBuffer: true;"
            arjs="sourceType: webcam; trackingMethod: best; debugUIEnabled: false;"
            loading-screen="enabled: false"
        >
            <a-assets timeout="30000">
                <a-asset-item
                    id="solar-system"
                    src="/assets/models/scene.gltf"
                ></a-asset-item>
            </a-assets>
            <a-marker id="marker" type="pattern" url="/markers/pattern-bitmap.patt" emitevents="true">
                <a-entity
                    id="solar-model"
                    gltf-model="#solar-system"
                    position="0 0 0"
                    rotation="0 0 0"
                    scale="0.04 0.04 0.04"
                ></a-entity>
            </a-marker>
            <a-entity camera></a-entity>
        </a-scene>

        <div
            class="modal-backdrop"
            id="info-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modal-title"
            hidden
        >
            <section class="modal">
                <button
                    class="close"
                    id="close-modal"
                    aria-label="Close information"
                >
                    ×
                </button>
                <div class="language-toggle" role="group" aria-label="Pilihan bahasa"><button id="lang-id" type="button" aria-pressed="true">ID</button><button id="lang-en" type="button" aria-pressed="false">EN</button></div>
                <p class="eyebrow" id="modal-eyebrow">TENTANG PENGALAMAN</p>
                <h1 id="modal-title">Kosmos dalam genggaman.</h1>
                <p id="modal-description">Arahkan kamera ke marker bitmap untuk menjelajahi model tata surya melalui kamera. Bergerak lebih dekat, menjauh, dan gunakan kontrol zoom untuk menemukan orbit favoritmu.</p>
                <p class="how-to"><strong id="how-to-label">CARA MENGGUNAKAN</strong><br /><span id="how-to-copy">Izinkan akses kamera, lalu arahkan ponsel ke marker bitmap yang dicetak. Bergerak lebih dekat atau menjauh untuk menjelajahi model.</span><br /><a id="marker-link" href="/markers/pattern-bitmap.png" target="_blank" rel="noopener">Lihat / simpan gambar marker ↗</a></p>
                <hr />
                <footer class="modal-footer">
                    <p class="credit"><strong id="model-label">Model 3D</strong><br /><a href="https://skfb.ly/oKOqS" target="_blank" rel="noopener">“Solar System animation”</a> oleh Samer_Arab_S5<br /><span id="license-prefix">Dilisensikan di bawah </span><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.</p>
                    <p><span id="made-by-label">Dibuat oleh </span><a href="https://deutan.dev" target="_blank" rel="noopener">deutan.dev</a></p>
                    <a id="github-link" href="https://github.com/deutandev/astro-ar" target="_blank" rel="noopener">Lihat proyek di GitHub ↗</a>
                </footer>
            </section>
        </div>
        <script is:inline src="/app.js"></script>
    </body>
</html>
